# Base section options
KERNEL_SOURCE=https://github.com/Jbub5/android_kernel_xiaomi_mt6768
KERNEL_SOURCE_BRANCH=merlin-r-oss_right-version_v3-3-1
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# KernelSU section options
ENABLE_KERNELSU=true
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/tiann/KernelSU/main/kernel/setup.sh
KERNELSU_TAG=v1.0.1
ADD_KPROBES_CONFIG=false
KSU_HOOKS_PATCH=false
KSU_REVERT=true
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# APatch section options
ADD_APATCH_SUPPORT=false
FIX_APATCH_OPENELA=false

# Compiler section options
USE_CLANG=true
# Use a slightly older but highly compatible Proton Clang for Android 11
CLANG_SOURCE=https://github.com/kdrag0n/proton-clang.git
CLANG_BRANCH=master

USE_GCC=true
USE_GCC_64=true
# Use AOSP GCC 4.9 which is the gold standard for Android 11 kernels
GCC_64_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9
GCC_64_BRANCH=master

USE_GCC_32=true
GCC_32_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9
GCC_32_BRANCH=master

# Anykernel3 section options
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/Jbub5/AnyKernel3.git
ANYKERNEL3_BRANCH=proton

# Build section options
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 LD=ld.lld AS=llvm-as AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump READELF=llvm-readelf STRIP=llvm-strip CROSS_COMPILE=aarch64-linux-android- CROSS_COMPILE_ARM32=arm-linux-androideabi- CROSS_COMPILE_COMPAT=arm-linux-androideabi- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user
DISABLE_LTO=false
DISABLE_CC_WERROR=false
ENABLE_PYTHON2=false
ENABLE_CCACHE=false
REMOVE_UNUSED_PACKAGES=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/xiaoleGun/KernelSU_action/main/boot/boot.img

# Misc section options
OLD_ANDROID_SUPPORT=false
ADD_OVERLAYFS_CONFIG=false

# Proton specific section options
FIX_WIFI_SPEED=false
